exports[`dsh keyless credential journey snapshots > lists /credential in /help and stores the key without leaking it 1`] = `
"/compact — Compact older conversation history
/credential <REF> [<value>] — show or store a credential through the credentials service
/exit — Leave the terminal session
/feedback <text> — record feedback about this session
/goal [<objective>|clear|edit <objective>|pause|resume] — set or view the goal for a long-running
task
/help — List the commands this terminal resolves
/model [provider/model] — Show or switch the model this session uses
/permission <preset> — Switch the permission preset (sandbox mode + approval policy)
/plan [off|message] — Enter or leave plan mode
/quit — Leave the terminal session

